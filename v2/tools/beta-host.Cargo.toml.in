[package]
name = "unicode-beta-contract"
version = "0.1.0"
edition = "2021"
rust-version = "1.85"
[dependencies]
serde = { version = "=1.0.228", features = ["derive"] }
serde_json = { version = "=1.0.150", features = ["raw_value"] }
base64 = "=0.22.1"
tokio = { version = "=1.52.3", features = ["macros", "rt-multi-thread", "sync", "time"] }
uuid = { version = "=1.23.3", features = ["v4"] }
tempfile = "=3.27.0"
log = "=0.4.32"
tauri = { path = "tauri-stub" }
