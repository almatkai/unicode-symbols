{
  "schemaVersion": 3,
  "id": "com.tezbar.native.unicode-symbols",
  "slug": "unicode-symbols",
  "name": "Unicode Symbols Search",
  "version": "0.1.0",
  "description": "Browse and copy-paste common Unicode symbols.",
  "author": "almatkai",
  "icon": "resources/assets/command-icon.png",
  "runtime": "rust",
  "execution": "process",
  "protocolVersion": 1,
  "repository": "https://github.com/almatkai/unicode-symbols",
  "replaces": [
    "raycast.unicode-symbols"
  ],
  "platforms": [
    "macOS",
    "Windows"
  ],
  "commands": [
    {
      "name": "index",
      "title": "Search Unicode Symbol",
      "description": "Browse and copy-paste common Unicode symbols.",
      "mode": "view",
      "platforms": [
        "macOS",
        "Windows"
      ],
      "runtime": "rust",
      "concurrency": "serialize",
      "refreshMs": null,
      "gap": "Save as Snippet reports unsupported: the process host has no snippet creation API. Six original unpaired UTF-16 records reject character copy/paste; format copies and reference links remain available."
    }
  ],
  "preferences": [
    {
      "name": "searchResultLimitStr",
      "title": "Search results limit",
      "description": "Maximum number of items shown in the list. The lower the number of shown items is, the faster they'll be retrieved. Defaults to 100. Supports up to 1000 items.",
      "type": "textfield",
      "default": "100",
      "required": false
    },
    {
      "name": "viewType",
      "title": "View Type",
      "description": "Type of view to use to display the results.",
      "type": "dropdown",
      "data": [
        {
          "title": "List",
          "value": "list"
        },
        {
          "title": "Grid",
          "value": "grid"
        }
      ],
      "default": "grid",
      "required": false
    },
    {
      "name": "gridItemSize",
      "type": "dropdown",
      "required": false,
      "title": "Grid Item Size",
      "description": "Control the size of individual grid cells in the grid view.",
      "default": "medium",
      "data": [
        {
          "title": "Small",
          "value": "small"
        },
        {
          "title": "Medium",
          "value": "medium"
        },
        {
          "title": "Large",
          "value": "large"
        }
      ]
    },
    {
      "name": "dataSet",
      "type": "dropdown",
      "required": false,
      "title": "Data Set",
      "description": "The data set to use for the search. By default it uses the minimal data set, which contains about 5400 characters. The full set contains +40000 characters. Using this big of a dataset might impact performance. Note: In 'List View' only the minimal dataset is supported.",
      "default": "minimal",
      "data": [
        {
          "title": "Minimal",
          "value": "minimal"
        },
        {
          "title": "Full",
          "value": "full"
        }
      ]
    },
    {
      "name": "primaryAction",
      "type": "dropdown",
      "required": false,
      "title": "Primary Action",
      "description": "The action to perform when selecting an item.",
      "default": "paste",
      "data": [
        {
          "title": "Paste Character to Active App",
          "value": "paste"
        },
        {
          "title": "Copy Character to Clipboard",
          "value": "copy"
        }
      ]
    }
  ],
  "capabilities": [
    "clipboard.write",
    "clipboard.pasteText",
    "shell.open"
  ],
  "migrationPaths": {
    "nativeStore": "native-extensions-v2/unicode-symbols/storage.json",
    "legacyLocalStorage": "extensions/unicode-symbols/.tezbar-local-storage.json",
    "legacyRaycastLocalStorage": "extensions/raycast.unicode-symbols/.tezbar-local-storage.json",
    "legacyPackageLocalStorage": "extensions/packages/raycast.unicode-symbols/.tezbar-local-storage.json",
    "legacyRegistryLocalStorage": "extension-registry/packages/raycast.unicode-symbols/.tezbar-local-storage.json",
    "legacyBarePackageLocalStorage": "extensions/packages/unicode-symbols/.tezbar-local-storage.json",
    "legacyBareRegistryLocalStorage": "extension-registry/packages/unicode-symbols/.tezbar-local-storage.json",
    "legacyShimStorage": "extensions/unicode-symbols/localStorage.json",
    "legacyRaycastShimStorage": "extensions/raycast.unicode-symbols/localStorage.json",
    "legacyPackageShimStorage": "extensions/packages/raycast.unicode-symbols/localStorage.json",
    "legacyRegistryShimStorage": "extension-registry/packages/raycast.unicode-symbols/localStorage.json",
    "legacyBarePackageShimStorage": "extensions/packages/unicode-symbols/localStorage.json",
    "legacyBareRegistryShimStorage": "extension-registry/packages/unicode-symbols/localStorage.json"
  },
  "verification": [
    {
      "platform": "macOS",
      "state": "not-run",
      "note": "Real desktop QA remains unverified."
    },
    {
      "platform": "Windows",
      "state": "not-run",
      "note": "Real desktop QA remains unverified."
    }
  ],
  "artifacts": {},
  "files": {}
}
